<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN"
  "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="3.1">
  <part-list>
    <score-part id="P1"><part-name>Piano</part-name></score-part>
  </part-list>
  <part id="P1">
    <!-- 第 1 小节：正好 16 个 divisions = 4 拍（divisions=4） -->
    <measure number="1">
      <attributes>
        <divisions>4</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <sound tempo="120"/>
      <!-- C4 八分 -->
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>2</duration><type>eighth</type></note>
      <!-- 和弦：E4 + G4（<chord/> 不推进时间） -->
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>2</duration><type>eighth</type></note>
      <note><chord/><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><type>eighth</type></note>
      <!-- 休止八分（推进时间、不发声） -->
      <note><rest/><duration>2</duration><type>eighth</type></note>
      <!-- 附点四分 D4 = 6 -->
      <note><pitch><step>D</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type><dot/></note>
      <!-- 四分 E4 = 4 -->
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>4</duration><type>quarter</type></note>
    </measure>

    <!-- 第 2 小节：连音起点 + 变音 + 装饰音 + 双声部 backup -->
    <measure number="2">
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>4</duration><type>quarter</type>
        <tie type="start"/><notations><tied type="start"/></notations></note>
      <note><pitch><step>F</step><alter>1</alter><octave>4</octave></pitch><duration>4</duration><type>quarter</type></note>
      <!-- 装饰音：不占时值、不出声 -->
      <note><grace/><pitch><step>A</step><octave>4</octave></pitch><type>eighth</type></note>
      <!-- 声部 1 走到小节末 -->
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>8</duration><type>half</type></note>
      <!-- 回退到小节头，声部 2 的低音 -->
      <backup><duration>16</duration></backup>
      <note><pitch><step>C</step><octave>3</octave></pitch><duration>16</duration><type>whole</type></note>
    </measure>

    <!-- 第 3 小节：连音收尾（应与第 2 小节的 F4 合并成 3 拍） -->
    <measure number="3">
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>8</duration><type>half</type>
        <tie type="stop"/><notations><tied type="stop"/></notations></note>
      <note><rest/><duration>8</duration><type>half</type></note>
    </measure>
  </part>
</score-partwise>
